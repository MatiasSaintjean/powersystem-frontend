{
  "name": "powersystem-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/build-tests.mjs && karma start karma.conf.cjs --single-run",
    "test:watch": "node scripts/build-tests.mjs && karma start karma.conf.cjs",
    "format": "prettier --write src tests scripts *.json *.js *.cjs",
    "test:manual": "node scripts/build-tests.mjs && karma start karma.conf.cjs --browsers"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.25.12",
    "jasmine-core": "^5.12.1",
    "karma": "^6.4.4",
    "karma-jasmine": "^5.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "istanbul-lib-instrument": "^6.0.3",
    "prettier": "^3.6.2"
  }
}
